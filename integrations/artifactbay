#!/usr/bin/env bash
# Thin wrapper so any agent/shell can call `artifactbay push` / `artifactbay doctor`.
# Symlink onto PATH:   ln -s "$PWD/integrations/artifactbay" /usr/local/bin/artifactbay
# Then: artifactbay doctor | artifactbay push --name "..."
set -euo pipefail

# Resolve the symlink chain before taking the dirname: reached through the link
# above, a bare `dirname` yields /usr/local/bin, where the engine isn't. Done by
# hand rather than with `readlink -f`, which isn't on older BSD/macOS.
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  dir="$(cd -P "$(dirname "$self")" && pwd)"
  self="$(readlink "$self")"
  case "$self" in /*) ;; *) self="$dir/$self" ;; esac
done
HERE="$(cd -P "$(dirname "$self")" && pwd)"
exec python3 "$HERE/artifactbay_cli.py" "$@"
