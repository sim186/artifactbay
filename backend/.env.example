# Copy to .env and edit. All vars prefixed ARTIFACTBAY_.

# Dev default = Postgres from `docker compose up -d` (see ../docker-compose.yml).
ARTIFACTBAY_DATABASE_URL=postgresql+psycopg://artifactbay:artifactbay@localhost:5432/artifactbay
# Zero-setup fallback (no Docker): ARTIFACTBAY_DATABASE_URL=sqlite:///./artifactbay.db

# Public origin of the WEB app (SPA) — share links (/s/<id>) point here, so this
# must be the frontend host, NOT the API. Native dev = vite server on :5173.
# Used as the FALLBACK: when a request arrives through a proxy that sets
# X-Forwarded-Host (the bundled nginx does), links are built from that instead.
ARTIFACTBAY_BASE_URL=http://localhost:5173

# Honour X-Forwarded-Proto/Host when minting links. Safe behind a reverse proxy;
# set false if the API is exposed directly, where clients can forge the headers.
# ARTIFACTBAY_TRUST_FORWARDED_HOST=true

# Browser origins allowed to call the API with credentials (comma-separated).
# Only needed for the split dev setup; same-origin deploys behind nginx need none.
# ARTIFACTBAY_CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Conversation slices are provenance, not an archive — the server trims them.
# ARTIFACTBAY_MAX_CONVERSATION_BYTES=524288
# ARTIFACTBAY_MAX_CONVERSATION_MESSAGES=200

# Bootstrap write API key — seeded as a hashed key on startup. CHANGE THIS.
ARTIFACTBAY_API_KEY=ab_dev_changeme

# Auth — CHANGE all of these in real deploys.
ARTIFACTBAY_JWT_SECRET=dev-insecure-change-me-please-32byte-minimum
ARTIFACTBAY_ADMIN_USERNAME=admin
ARTIFACTBAY_ADMIN_PASSWORD=admin
# ARTIFACTBAY_COOKIE_SECURE=true   # enable behind HTTPS
